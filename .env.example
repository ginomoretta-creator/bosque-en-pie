# Copiar a .env y completar. Solo claves de PRUEBA, sin valor real.

# Red Fuji (C-Chain)
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113

# Curador: cuenta que despliega y registra parcelas
CURATOR_PRIVATE_KEY=

# Verificadores (3 claves distintas)
VERIFIER_1_PRIVATE_KEY=
VERIFIER_2_PRIVATE_KEY=
VERIFIER_3_PRIVATE_KEY=

# Cuenta que envía los informes firmados (puede ser cualquiera)
RELAYER_PRIVATE_KEY=

# Dirección del contrato desplegado
CONTRACT_ADDRESS=
